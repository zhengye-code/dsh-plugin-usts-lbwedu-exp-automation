{
  "name": "dsh-plugin-ibwedu-lab",
  "version": "1.0.0",
  "type": "module",
  "description": "DSH plugin for the USTS Ibwedu (lbwedu) smart-lab: drive the noVNC experiment VM and the platform page from a DSH conversation.",
  "main": "lib/plugin.js",
  "exports": {
    ".": "./lib/plugin.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "runtime": "host",
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "lab",
    "vnc",
    "novnc",
    "automation",
    "usts"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/zhengye-code/dsh-plugin-usts-lbwedu-exp-automation.git"
  },
  "homepage": "https://github.com/zhengye-code/dsh-plugin-usts-lbwedu-exp-automation#readme",
  "bugs": {
    "url": "https://github.com/zhengye-code/dsh-plugin-usts-lbwedu-exp-automation/issues"
  },
  "license": "UNLICENSED"
}
